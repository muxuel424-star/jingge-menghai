{
  "name": "jingge-menghai",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node --watch-path=src --watch-path=assets/side --watch-path=index.html --watch-path=build.mjs build.mjs --serve 8124",
    "build:pages": "node build.mjs --pages",
    "test": "node --test",
    "test:replay": "node --test --test-name-pattern=replay test/sim.test.js",
    "test:smoke": "node tools/smoke.cjs",
    "test:shots": "node tools/full-run.mjs && node tools/browser-replay.cjs && node tools/visual-check.cjs",
    "test:full": "node tools/full-run.mjs && node tools/browser-replay.cjs",
    "test:perf": "node tools/perf.cjs",
    "test:audio": "node tools/audio-check.cjs",
    "test:motion": "node tools/motion-check.cjs"
  },
  "dependencies": {
    "esbuild": "0.25.10"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
